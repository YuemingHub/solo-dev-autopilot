#!/usr/bin/env bash
# Solo Dev Autopilot — pre-commit P0/P1 检查
# P0: 阻止提交（硬编码密钥、空 catch、.env 暂存）
# P1: 警告但不阻止（裸 any 类型、console.log 残留）

set -e

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

errors=0
warnings=0

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(ts|tsx|js|jsx|py|go|rs)$" || true)

if [ -z "$staged_files" ]; then
  exit 0
fi

echo -e "${YELLOW}[pre-commit]${NC} 运行检查..."

# ---- P0: 阻止提交 ----

# P0-1: 硬编码密钥
for file in $staged_files; do
  if git diff --cached -- "$file" | grep -iE "(password|secret|api_key|apikey|token)\s*[:=]\s*[\"'][^\"']{8,}" 2>/dev/null; then
    echo -e "${RED}[P0] 检测到可能的硬编码密钥：${file}${NC}"
    errors=$((errors + 1))
  fi
done

# P0-2: 空 catch 块
for file in $staged_files; do
  if git diff --cached -- "$file" | grep -E "^\+.*catch\s*\([^)]*\)\s*\{\s*\}" 2>/dev/null; then
    echo -e "${RED}[P0] 检测到空 catch 块：${file}${NC}"
    errors=$((errors + 1))
  fi
done

# P0-3: .env 被暂存
if git diff --cached --name-only | grep -qE "^\.env$"; then
  echo -e "${RED}[P0] .env 文件被暂存了！请加入 .gitignore${NC}"
  errors=$((errors + 1))
fi

# ---- P1: 警告但不阻止 ----

# P1-1: 裸 any 类型（仅 TS/TSX，精确匹配减少误报）
for file in $staged_files; do
  if echo "$file" | grep -qE "\.(ts|tsx)$"; then
    if git diff --cached -- "$file" | grep -E "^\+.*:\s*any[^a-zA-Z]" 2>/dev/null; then
      echo -e "${YELLOW}[P1] 检测到 any 类型：${file}（建议用 unknown 或具体类型）${NC}"
      warnings=$((warnings + 1))
    fi
  fi
done

# P1-2: console.log 残留（仅 JS/TS）
for file in $staged_files; do
  if echo "$file" | grep -qE "\.(ts|tsx|js|jsx)$"; then
    if git diff --cached -- "$file" | grep -E "^\+.*console\.log" 2>/dev/null; then
      echo -e "${YELLOW}[P1] 检测到 console.log：${file}（生产代码建议移除）${NC}"
      warnings=$((warnings + 1))
    fi
  fi
done

# ---- 结果 ----
if [ "$warnings" -gt 0 ]; then
  echo -e "${YELLOW}[pre-commit] ${warnings} 个 P1 警告（不影响提交）${NC}"
fi

if [ "$errors" -gt 0 ]; then
  echo -e "${RED}[pre-commit] 发现 ${errors} 个 P0 问题，提交已阻止。${NC}"
  echo -e "${YELLOW}修复后重新提交：git add <文件> && git commit${NC}"
  exit 1
fi

echo -e "${GREEN}[pre-commit] 检查通过（${warnings} 警告, 0 阻止）${NC}"
exit 0