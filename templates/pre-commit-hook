NC='\033[0m'

errors=0

staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(ts|tsx|js|jsx|py|go|rs)$" || true)

if [ -z "$staged_files" ]; then
  exit 0
fi

echo -e "${YELLOW}[pre-commit]${NC} ?? P0 ??..."

# ??1:?????
for file in $staged_files; do
  if git diff --cached -- "$file" | grep -iE "(password|secret|api_key|apikey|token)\s*[:=]\s*[\"'][^\"']{8,}" 2>/dev/null; then
    echo -e "${RED}[P0] ???????????:${file}${NC}"
    errors=$((errors + 1))
  fi
done

# ??2:? catch ?
for file in $staged_files; do
  if git diff --cached -- "$file" | grep -E "^\+.*catch\s*\([^)]*\)\s*\{\s*\}" 2>/dev/null; then
    echo -e "${RED}[P0] ???? catch ?:${file}${NC}"
    errors=$((errors + 1))
  fi
done

# ??3:? any ??(TS/JS)
for file in $staged_files; do
  if echo "$file" | grep -qE "\.(ts|tsx)$"; then
    if git diff --cached -- "$file" | grep -E "^\+.*:\s*any\b" 2>/dev/null; then
      echo -e "${YELLOW}[P0] ??? any ??:${file}(??? unknown ?????)${NC}"
      errors=$((errors + 1))
    fi
  fi
done

# ??4:.env ???
if git diff --cached --name-only | grep -qE "^\.env$"; then
  echo -e "${RED}[P0] .env ??????!??? .gitignore${NC}"
  errors=$((errors + 1))
fi

if [ "$errors" -gt 0 ]; then
  echo -e "${RED}[pre-commit] ?? ${errors} ? P0 ??,??????${NC}"
