{"_comment": "Reasonix 适配配置", "_usage": "将此内容合并到 ~/.reasonix/config.json 的 mcp.servers 字段", "mcpServers": {"github": {"transport": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"], "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"}}, "postgres": {"transport": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-postgres"], "env": {"POSTGRES_CONNECTION_STRING": "${DATABASE_URL}"}}, "filesystem": {"transport": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "${PROJECT_ROOT}"]}, "sequential-thinking": {"transport": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]}}, "permissions": {"shell": {"allow": ["npm test", "npm run ", "git ", "pnpm ", "bun ", "cat ", "ls ", "grep ", "head ", "tail "]}},"hooks":{"PostToolUse":[{"matcher":{"tool":"edit_file"},"command":"npx biome format --write {{file}} 2>/dev/null || true","description":"编辑文件后自动格式化"}],"Stop":[{"command":"bash scripts/post-session.sh","description":"会话结束：生成代码地图 + 更新记忆"}]}}