{"_comment": "Claude Code 适配配置", "_usage": "将此内容合并到 ~/.claude/settings.json 或项目的 .claude/settings.json", "permissions": {"allow": ["Bash(npm:*)", "Bash(pnpm:*)", "Bash(bun:*)", "Bash(git:*)", "Bash(cat:*)", "Bash(ls:*)", "Bash(grep:*)", "Bash(head:*)", "Bash(tail:*)", "Bash(wc:*)", "Bash(find:*)", "Read", "Write", "Edit"], "deny": ["Bash(rm -rf /)", "Bash(sudo:*)"]}, "mcpServers": {"github": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"], "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"}}, "postgres": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-postgres"], "env": {"POSTGRES_CONNECTION_STRING": "${DATABASE_URL}"}}, "filesystem": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "${PROJECT_ROOT}"]}, "sequential-thinking": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]}}, "skillsPath": ".claude/skills", "postCommands": [{"command": "echo 'Session ended. Running post-session hooks...'", "description": "Post-session notification"}]}