{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creating Forward Task Graph",
  "type": "object",
  "required": ["version", "tasks"],
  "properties": {
    "version": {
      "const": "0.4.0-dev"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "task.schema.json"
      }
    }
  },
  "additionalProperties": false
}
